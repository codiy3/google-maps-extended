# 初期値は外部地図へ接続しないpreviewです。
# 無料のMaps Demo Keyを確認後、googleに変更すると接続します。
VITE_GOOGLE_MAPS_MODE=preview
# Maps Demo Key（試作用）。通常のAPIキーの無料利用は保証しません。
# HTTPリファラーを http://127.0.0.1:5173/* に制限してください。
# 使用APIもMaps JavaScript APIに制限してください。
# キーはブラウザから閲覧可能です。秘密の時刻表APIキーはここに入れないでください。
VITE_GOOGLE_MAPS_API_KEY=
# 開発用ID。公開前には自身のJavaScript用Map IDへ変更してください。
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
