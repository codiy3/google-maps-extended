{
  "name": "google-maps-railway-viewer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "build:public": "tsc -b && vite build --mode public",
    "preview:public": "vite preview --mode public --host 127.0.0.1 --port 5175 --strictPort",
    "data:public": "uv run --locked python -m railway_data.static_export --archive data/raw/N02-25_GML.zip --directory public/data",
    "check": "biome check src scripts index.html vite.config.ts && tsc -b",
    "format": "biome check --write src scripts index.html vite.config.ts",
    "test": "vitest run",
    "test:launch": "node --test scripts/*.test.mjs",
    "data:build": "uv run --locked python -m railway_data.export --archive data/raw/N02-25_GML.zip"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "2.1.1",
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/google.maps": "3.66.6",
    "@types/leaflet": "1.9.20",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
